{
  "manifest_version": 3,
  "name": "SVG Clipboard Exporter",
  "version": "2.1.0",
  "description": "クリップボードにコピーまたはドラッグ＆ドロップされたSVGをPNGまたはJPG画像へ変換してコピー・保存できる拡張機能です。Convert copied or dropped SVG to PNG/JPG.",
  "permissions": [
    "storage",
    "clipboardRead",
    "clipboardWrite",
    "offscreen"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "SVG Clipboard Exporter",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*",
        "http://*/*"
      ],
      "js": [
        "src/content/clipboard-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*/*",
        "http://*/*"
      ],
      "js": [
        "src/shared/settings.js",
        "src/shared/i18n.js",
        "src/shared/svg-utils.js",
        "src/shared/renderer.js",
        "src/content/content.js"
      ],
      "css": [
        "src/content/content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
